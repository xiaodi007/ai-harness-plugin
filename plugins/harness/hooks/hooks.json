{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/session-start.mjs\"",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/card-check.mjs\" --stop",
            "timeout": 10,
            "statusMessage": "检查任务卡交付项"
          },
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/context-watch.py\"",
            "timeout": 10,
            "statusMessage": "检查会话规模"
          }
        ]
      }
    ]
  }
}
